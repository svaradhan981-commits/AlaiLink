APP_NAME=AlaiLink
ENVIRONMENT=local
LLM_PROVIDER=openai_compatible
LLM_MODEL=gemini-3.5-flash-lite
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=1
LLM_RETRY_DELAY_SECONDS=1
LLM_FALLBACK_MODEL=
# Set this in your local .env file. Never commit a real API key.
LLM_API_KEY=
DATABASE_URL=postgresql+psycopg://alailink:alailink@localhost:5432/alailink
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# Optional; falls back to LLM_API_KEY when unset.
EMBEDDING_API_KEY=
EMBEDDING_DIMENSIONS=768
EMBEDDING_TIMEOUT_SECONDS=60
RAG_TOP_K=5
RAG_MAX_DISTANCE=0.65
PAGES_DIRECTORY=data/raw/pages
PDFS_DIRECTORY=data/raw/pdfs